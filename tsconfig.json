{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "esnext",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "expo-router/native-tabs": [
        "node_modules/expo-router/unstable-native-tabs"
      ]
    }
  },
  "include": [
    "src",
    "app"
  ],
  "exclude": [
    "node_modules"
  ]
}
