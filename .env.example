# Backend
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_USE_SUPABASE=true
EXPO_PUBLIC_API_BASE_URL=https://api.ehlibyte.com
EXPO_PUBLIC_EAS_PROJECT_ID=

# RevenueCat public SDK keys only. Never put an sk_ secret key in EXPO_PUBLIC_*.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your_public_key
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=test_your_public_key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=premium
# Development defaults to mock payments. Set true only when StoreKit/App Store products are configured.
EXPO_PUBLIC_USE_REVENUECAT=false

# AdMob production app/unit IDs. Empty values use Google's test IDs only outside production.
EXPO_PUBLIC_ENABLE_ADS=false
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-your-ios-app-id
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-your-android-app-id
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID=
EXPO_PUBLIC_ADMOB_APP_OPEN_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# Yandex Mobile Ads production placement IDs. Values look like R-M-123456-1.
EXPO_PUBLIC_YANDEX_ADS_BANNER_UNIT_ID=
EXPO_PUBLIC_YANDEX_ADS_INTERSTITIAL_UNIT_ID=
